# Build-time config for the deployed dashboard (faisal6003.ssh.bd).
# Vite reads this for `npm run build`; `.env` still drives `npm run dev`.
#
# This origin must also be listed in the backend's EXTRA_CORS_ORIGINS, or the
# browser blocks every call from the dashboard.
VITE_BACKEND_BASE=https://faisal6001.ssh.bd
